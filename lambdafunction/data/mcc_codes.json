import argparse
import json
import os

from openai import OpenAI


class OpenAIConfigError(RuntimeError):
    pass


def get_openai_api_key() -> str:
    api_key = os.environ.get("OPENAI_API_KEY")
    if not api_key:
        raise OpenAIConfigError("OPENAI_API_KEY environment variable is not set")
    return api_key


def get_openai_client() -> OpenAI:
    return OpenAI(api_key=get_openai_api_key())


def get_mcc_style_category(normalized_name: str, model: str = "gpt-4.1-mini") -> str:
    """Ask OpenAI to map a merchant name to an MCC-style category description.

    The goal is to produce something close to our MCC `edited_description` values, e.g.:
    - "FAST FOOD RESTAURANTS"
    - "GROCERY STORES, SUPERMARKETS"
    - "GASOLINE SERVICE STATIONS"
    - "DEPARTMENT STORES"
    """
    client = get_openai_client()

    system_prompt = (
        "You are a merchant category classifier for payment cards.\n"
        "You receive a cleaned merchant name (like a brand name).\n"
        "Respond with a SINGLE SHORT CATEGORY DESCRIPTION in uppercase, suitable for an MCC directory, such as:\n"
        "  FAST FOOD RESTAURANTS\n"
        "  GROCERY STORES, SUPERMARKETS\n"
        "  GASOLINE SERVICE STATIONS\n"
        "  HOTELS, MOTELS, RESORTS\n"
        "  DEPARTMENT STORES\n"
        "  CLOTHING STORES\n"
        "Do not include the merchant name itself unless the category truly is brand-specific.\n"
        "Respond with ONLY the category text, no extra words."
    )

    user_prompt = f"MERCHANT NAME: {normalized_name}"

    response = client.responses.create(
        model=model,
        input=[
            {"role": "system", "content": system_prompt},
            {"role": "user", "content": user_prompt},
        ],
    )

    content = response.output[0].content[0].text  # type: ignore[attr-defined]
    return content.strip().upper()


def main() -> None:
    parser = argparse.ArgumentParser(description="Classify a merchant using local MCC data.")
    parser.add_argument("name", nargs="+", help="Raw merchant name")
    parser.add_argument("--no-openai", action="store_true", help="(ignored) kept for compatibility")

    args = parser.parse_args()
    raw_name = " ".join(args.name)

    result = get_mcc_style_category(raw_name)
    print(json.dumps(result, indent=2))


if __name__ == "__main__":
    main()
